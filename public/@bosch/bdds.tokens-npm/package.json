{
  "name": "@bosch/bdds.tokens-npm",
  "version": "2.5.0",
  "description": "Style Dictionary setup to generate design token derived artifacts",
  "main": "./dist/brands.js",
  "types": "./dist/types.d.ts",
  "files": [
    "*"
  ],
  "exports": {
    ".": {
      "types": "./dist/types.d.ts"
    },
    "./brands": {
      "import": "./dist/brands.js",
      "types": "./dist/brands.d.ts"
    },
    "./pro": {
      "import": "./dist/brands/pro/tokens/index.js",
      "types": "./dist/brands/pro/tokens/types.d.ts"
    },
    "./pro/backgrounds/*": {

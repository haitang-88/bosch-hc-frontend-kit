    },
    "./pro/backgrounds/*.ts": {
      "import": "./dist/brands/pro/styles/backgrounds/*.ts"
    },
    "./pro/backgrounds/*.css": {
      "style": "./dist/brands/pro/styles/backgrounds/*.css",
      "import": "./dist/brands/pro/styles/backgrounds/*.css"
    },
    "./pro/gradations/*": {
      "import": "./dist/brands/pro/styles/gradations/*.css"
